# Скопируйте в server/.env на VPS (один файл для сайта и бота).

STEAM_BOT_ENABLED=1
STEAM_BOT_PORT=3847
STEAM_BOT_DRY_RUN=0

# Отдельный аккаунт Steam с TF2-ключами в инвентаре:
STEAM_BOT_ACCOUNT_NAME=
STEAM_BOT_PASSWORD=
# shared_secret из Mobile Authenticator (maFile / SDA):
STEAM_BOT_SHARED_SECRET=

# Подпись вебхука (придумайте сами, 32+ символа):
SKINEX_STEAM_KEYS_WEBHOOK_SECRET=
